{
  "name": "@splithub/adapter-sqlite",
  "version": "0.5.0",
  "description": "SQLite store for self-hosted SplitHub experiments and analytics from websites and apps, on the SQLite built into Node. Nothing to compile.",
  "keywords": [
    "splithub",
    "ab-testing",
    "a-b-testing",
    "experiments",
    "split-testing",
    "analytics",
    "web-analytics",
    "product-analytics",
    "sqlite",
    "node-sqlite",
    "self-hosted",
    "store"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splithub-io/splithub-sdk.git",
    "directory": "packages/adapter-sqlite"
  },
  "homepage": "https://splithub.io",
  "bugs": {
    "url": "https://github.com/splithub-io/splithub-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@splithub/node": "workspace:*"
  },
  "devDependencies": {
    "@splithub/core": "workspace:*",
    "@types/node": "^22.13.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
