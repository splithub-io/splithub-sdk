{
  "name": "splithub",
  "version": "0.5.1",
  "description": "Experiments and analytics for your website or app in one command: create an A/B experiment, read a plain verdict, check traffic, funnels and retention. Sets up React Native, Expo, iOS and Android apps too. Works for you and for your coding agent.",
  "keywords": [
    "splithub",
    "ab-testing",
    "a-b-testing",
    "experiments",
    "split-testing",
    "analytics",
    "web-analytics",
    "product-analytics",
    "funnels",
    "mcp",
    "ai-agents",
    "cli",
    "claude-code",
    "cursor",
    "conversion-rate-optimization",
    "retention",
    "feature-experiments",
    "mobile-analytics",
    "react-native",
    "expo",
    "ios",
    "android",
    "mobile",
    "app"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splithub-io/splithub-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://splithub.io",
  "bugs": {
    "url": "https://github.com/splithub-io/splithub-sdk/issues"
  },
  "type": "module",
  "bin": {
    "splithub": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@splithub/core": "workspace:*",
    "@splithub/node": "workspace:*",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.27.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": ">=4.7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
