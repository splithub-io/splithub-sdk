{
  "name": "@splithub/adapter-d1",
  "version": "0.5.0",
  "description": "Cloudflare D1 store for self-hosted SplitHub experiments and analytics from websites and apps on Workers, with an in-memory D1 for tests.",
  "keywords": [
    "splithub",
    "ab-testing",
    "a-b-testing",
    "experiments",
    "split-testing",
    "analytics",
    "web-analytics",
    "product-analytics",
    "cloudflare",
    "cloudflare-d1",
    "d1",
    "workers",
    "self-hosted",
    "store"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splithub-io/splithub-sdk.git",
    "directory": "packages/adapter-d1"
  },
  "homepage": "https://splithub.io",
  "bugs": {
    "url": "https://github.com/splithub-io/splithub-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@splithub/node": "workspace:*"
  },
  "devDependencies": {
    "@splithub/core": "workspace:*",
    "@types/node": "^22.13.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
